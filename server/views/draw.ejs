<%- include('partials/head', { title }) %>
<%- include('partials/nav') %>

<section class="page">
  <div class="page__header">
    <h1>Draw Test</h1>
    <p class="muted">Draw on the canvas, then publish it to the gallery.</p>
  </div>

  <div class="card">
    <div class="toolbar" id="toolbar">
      <button type="button" id="save">Save as image</button>

      <div class="size-picker" role="group" aria-label="Artboard size presets">
        <span class="toolbar__label">Artboard size</span>
        <button type="button" class="size-btn is-active" data-size="postcard">Postcard</button>
        <button type="button" class="size-btn" data-size="poster">Poster</button>
        <button type="button" class="size-btn" data-size="banner">Banner</button>
      </div>
      <p class="toolbar__note" id="sizeLockNote">Size locks after your first stroke.</p>

      <button type="button" id="pick-bg">Background image</button>
      <input id="bg-upload" type="file" accept="image/*" hidden />

      <label class="toolbar__label" for="stroke">Colour</label>
      <input id="stroke" name="stroke" type="color" value="#111827" />

      <label class="toolbar__label" for="width">Stroke</label>
      <select id="width" name="width">
        <option value="2">Thin</option>
        <option value="5" selected>Medium</option>
        <option value="10">Thick</option>
        <option value="20">Extra thick</option>
      </select>

      <button type="button" id="clear" class="danger">Clear</button>
    </div>

    <div class="board" id="board">
      <canvas id="background-board" aria-hidden="true"></canvas>
      <canvas id="drawing-board"></canvas>
    </div>
    <p class="muted small">Drag and drop an image onto the artboard to use it as a background.</p>

    <div class="publish">
      <% if (currentUser) { %>
        <form method="post" action="/publish" id="publishForm" class="publish__form">
          <input type="hidden" name="imageData" id="imageData" />
          <input type="text" name="caption" placeholder="Caption (optional)" maxlength="120" />
          <button type="submit" class="btn">Publish to gallery</button>
        </form>
        <p class="muted small">Publishing uploads a PNG/JPEG snapshot of your canvas.</p>
      <% } else { %>
        <div class="publish__signin">
          <p class="muted">Sign in to publish your drawing to the gallery.</p>
          <a class="btn" href="/auth/signin">Sign in</a>
          <a href="/auth/signup">Create an account</a>
        </div>
      <% } %>
    </div>
  </div>
</section>

<script src="/draw.js"></script>
<%- include('partials/foot') %>

